{
  "name": "sdynotes-fast",
  "version": "14.13.9",
  "type": "module",
  "description": "SDYnotes backend - Fastify main server + Python worker for heavy jobs (oracle self-hosted storage)",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "migrate:oracle": "node scripts/migrate_to_oracle.mjs",
    "migrate:oracle:dry": "node scripts/migrate_to_oracle.mjs --dry",
    "test:motion": "node test/claw_cursor_contract.mjs && node test/home_stack_contract.mjs",
    "test:bounds": "node test/floating_window_bounds_contract.mjs && node test/floating_window_bounds_zoom_sim.mjs",
    "test:music": "node test/music_controls.mjs && node test/music_queue_contract.mjs && node test/music_ui_position_contract.mjs",
    "test:bgm": "node test/yp_bgm_sync.cjs",
    "test:auth": "node test/auth_contract.mjs",
    "test:friends": "node test/friends_dm_contract.mjs && node test/yf_dm_frontend_contract.cjs",
    "test:gate": "node test/yp_gate_contract.cjs",
    "test:smtp": "node test/smtp_contract.mjs",
    "test:musicfs": "node test/music_fs_smoke.mjs",
    "test:phone": "node test/phone_layout_contract.mjs && node test/mobile_runtime_smoke.mjs",
    "test:table": "node test/editor_table_contract.mjs && node test/editor_table_runtime.mjs",
    "test:place": "node test/editor_place_runtime.mjs",
    "test:polish": "node test/ui_polish_orientation_contract.mjs && python3 test/import_orientation_runtime.py",
    "test:sync": "node test/note_sync_clock_contract.mjs && node test/collab_protocol.cjs && node test/merge3_unit.cjs && node test/empty_note_render_contract.mjs && node test/import_retry_contract.mjs",
    "test:fastops": "node test/editor_fast_ops_contract.mjs && node test/editor_fast_switch_runtime.mjs",
    "test:font": "node test/editor_font_size_contract.mjs && node test/editor_font_size_runtime.mjs",
    "test:format": "node test/editor_format_runtime.mjs",
    "test:pages": "node test/editor_pages_sync_contract.mjs && node test/editor_pages_sync_runtime.mjs",
    "test:save": "node test/save_outbox_contract.mjs",
    "test:oracle": "node test/oracle_db_contract.mjs && node test/sdb_shim_contract.mjs && node test/migrate_oracle_sim.mjs",
    "test:call": "node test/call_relay_contract.mjs && node test/chat_endpoint.mjs && node test/voice_relay_contract.mjs && node test/yp_smoke_v4.cjs && python3 test/nginx_voice_ws_patch_test.py",
    "test:translate": "node test/translate_contract.mjs && node test/translate_flow_runtime.mjs",
    "test:perf": "node test/perf_tuning_contract.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "cloudinary": "^2.5.1",
    "fastify": "^5.1.0",
    "sharp": "^0.33.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "css-tree": "^3.2.1",
    "jsdom": "^29.1.1"
  }
}
